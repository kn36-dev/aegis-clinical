########################################
# Environment
########################################

ENVIRONMENT=development

########################################
# LLM
########################################

LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3-32b
REASONING_TEMPERATURE=0.0

GROQ_API_KEY=

########################################
# Embedding <-> Vector Index compatibility boundary
#
# These three must match whatever actually populated your target
# Upstash Vector index, or the app refuses to start
# (EmbeddingCompatibilityError). The values below match the index
# produced by scripts/upload_index.py as currently configured
# (SentenceTransformers, BAAI/bge-large-en-v1.5, 1024 dimensions).
# Set EMBEDDING_PROVIDER=openai / EMBEDDING_MODEL=text-embedding-3-small
# / EMBEDDING_DIMENSIONS=1536 (plus OPENAI_API_KEY) only after
# re-running the offline pipeline with OpenAI embeddings.
########################################

EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSIONS=1024
OPENAI_API_KEY=

########################################
# Upstash Vector
########################################

UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

########################################
# Upstash Redis
########################################

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CACHE_TTL_SECONDS=2592000

########################################
# Retrieval
########################################

RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=