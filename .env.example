########################################
# Environment
########################################

ENVIRONMENT=development

# Selects which collaborators aegis.api.bootstrap assembles for the
# cache, reasoning, content-repository, and (demo-local only)
# vector-retrieval boundaries. ICD taxonomy validation is always real.
# See CLAUDE.md's demo-profile design.
#   production  -- Upstash Redis cache, Groq/CrewAI reasoning, SQLite
#                  content store, real Upstash Vector retrieval.
#                  Requires GROQ_API_KEY, the Upstash Redis credentials,
#                  and the Upstash Vector + EMBEDDING_* settings below.
#   demo        -- in-memory cache, deterministic top-candidate
#                  reasoning, in-memory content store pre-seeded with a
#                  fixed set of sample notes, real Upstash Vector
#                  retrieval. Does NOT require GROQ_API_KEY or the
#                  Upstash Redis credentials, but still needs Upstash
#                  Vector + EMBEDDING_* below.
#   demo-local  -- same in-memory cache/reasoning/content-store as
#                  demo, PLUS a local, file-backed vector index
#                  compiled from the real ICD-11 taxonomy in place of
#                  Upstash Vector. Requires NO credentials at all --
#                  not GROQ_API_KEY, not Upstash Redis, not Upstash
#                  Vector, not OPENAI_API_KEY. EMBEDDING_* below default
#                  to sentence_transformers/BAAI/bge-large-en-v1.5/1024
#                  if left unset. See docs/demo.md.
#   integration -- same real collaborators as production (Upstash Redis
#                  cache, Groq/CrewAI reasoning), but the same in-memory
#                  pre-seeded content store demo uses. Requires
#                  GROQ_API_KEY and the Upstash Redis credentials below.
#                  Used by `make integration` (scripts/integration_e2e.py)
#                  to verify real infrastructure wiring end to end.
AEGIS_PROFILE=production

########################################
# LLM
########################################

LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
REASONING_TEMPERATURE=0.0

# Required only when AEGIS_PROFILE=production or integration.
GROQ_API_KEY=

########################################
# Embedding <-> Vector Index compatibility boundary
#
# These three must match whatever actually populated your target
# Upstash Vector index, or the app refuses to start
# (EmbeddingCompatibilityError). The values below match the index
# produced by scripts/upload_index.py as currently configured
# (SentenceTransformers, BAAI/bge-large-en-v1.5, 1024 dimensions).
# Set EMBEDDING_PROVIDER=openai / EMBEDDING_MODEL=text-embedding-3-small
# / EMBEDDING_DIMENSIONS=1536 (plus OPENAI_API_KEY) only after
# re-running the offline pipeline with OpenAI embeddings.
#
# Required in production/demo/integration. Under AEGIS_PROFILE=demo-local
# there is no live external index to match, so these three may be left
# unset -- they default to the values shown below.
########################################

EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSIONS=1024
OPENAI_API_KEY=

########################################
# Upstash Vector
#
# Required in production/demo/integration. NOT required under
# AEGIS_PROFILE=demo-local, which serves retrieval from a compiled
# local vector index instead (see docs/demo.md).
########################################

UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

########################################
# Upstash Redis
########################################

# Required only when AEGIS_PROFILE=production or integration.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CACHE_TTL_SECONDS=2592000

# Optional. Redis key namespace, isolating environments that share a
# single Upstash Redis instance (e.g. production vs. integration).
# Defaults to AEGIS_PROFILE when unset -- override only if you need a
# namespace that differs from the profile name (e.g. two isolated
# integration suites against the same Redis instance).
REDIS_CACHE_NAMESPACE=

########################################
# Retrieval
########################################

RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=

########################################
# Workflow observability
########################################

# PHI/debug boundary for GET /api/v1/workflows/{workflow_id}. When true,
# a caller may additionally request ?include_artifacts=true to receive
# the raw RetrievalResult/ReasoningContext/CodingRecommendation payload
# produced at each stage. Independent of AEGIS_PROFILE -- set true for
# demo/staging, leave false in production.
EXPOSE_WORKFLOW_ARTIFACTS=false